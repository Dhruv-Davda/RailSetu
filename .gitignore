# all reproducible from predict.py.
railsetu-m3/bundle/
railsetu-m3/artifacts/predictions_*/
railsetu-m3/__pycache__/

# Written for the submission form and the demo recordings: both are working
# material, not part of the platform. The recordings are also ~65 MB of video,
